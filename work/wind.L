  1291: +------>           DO I=1,NP
  1292: |                     WindX = WVNX1(I) + WTRatio*(WVNX2(I)-WVNX1(I))
  1293: |                     WindY = WVNY1(I) + WTRatio*(WVNY2(I)-WVNY1(I))
  1294: |                     WindMag = SQRT(WindX*WindX+WindY*WindY)
  1295: |       I             WDragCo = WindDrag(WindMag, I)
  1296: |         C     jgf46.00 Add directional wind reduction.
  1297: |                     IF (LoadDirEffRLen) THEN
  1298: |       I                CALL ApplyDirectionalWindReduction(I, WDragCo,
  1299: |              &              WindMag, DP(I), ETA2(I), WindX, WindY)
  1300: |                        WindMag = SQRT(WindX*WindX+WindY*WindY)
  1301: |       I                WDragCo = WindDrag(WindMag, I)
  1302: |                     ENDIF
  1303: |                     IF (LoadCanopyCoef)
  1304: |       I      &         CALL ApplyCanopyCoefficient(I,WindX,WindY)
  1305: |         C    TCM V49.64.01 ADDED ICE EFFECTS ON WIND DRAG COEFF
  1306: |                     IF (NCICE.eq.10) then
