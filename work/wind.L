  2959:           C
  2960:           C     jgf49.1001 Added NWS29, asymmetric vortex winds (NWS19)
  2961:           C     embedded in an OWI basin scale gridded met field (NWS12)
  2962:           C     from NAM data
  2963:                 ! jgf: Added NWS30 (GAHM+OWI)
  2964:                 IF ((abs(NWS).EQ.29).or.(abs(NWS).eq.30)) THEN
  2965:                    ! Now blend in the vortex winds into the background OWI wind field.
  2966:                    ALLOCATE(vortexWVNX2(NP),vortexWVNY2(NP),vortexPRN2(NP))
  2967:                    if (abs(nws).eq.29) then
  2968:                       OPEN(22,FILE=TRIM(GBLINPUTDIR)//'/'//'NWS_19_fort.22',
  2969:                &           STATUS='OLD')
  2970:                       CALL NWS19GET(vortexWVNX2,vortexWVNY2,vortexPRN2,TimeLoc)
  2971:                    endif
  2972:                    if (abs(nws).eq.30) then
  2973:                       OPEN(22,FILE=TRIM(GBLINPUTDIR)//'/'//'NWS_20_fort.22',
  2974:                &           STATUS='OLD')
  2975:                       CALL NWS20GET(vortexWVNX2,vortexWVNY2,vortexPRN2,TimeLoc)
  2976:                    endif
  2977: +------>           DO I=1,NP
  2978: |                     WindX = vortexWVNX2(I)
  2979: |                     WindY = vortexWVNY2(I)
  2980: |                     WindMag = SQRT(WindX*WindX+WindY*WindY)
  2981: |       I             WDragCo = WindDrag(WindMag, I)
  2982: |                     IF (LoadDirEffRLen) THEN
  2983: |       I                CALL ApplyDirectionalWindReduction(I, WDragCo,
  2984: |              &              WindMag, DP(I), ETA2(I), WindX, WindY)
  2985: |                        WindMag = SQRT(WindX*WindX+WindY*WindY)
  2986: |       I                WDragCo = WindDrag(WindMag, I)
  2987: |                     ENDIF
  2988: |                     IF (LoadCanopyCoef)
  2989: |       I      &         CALL ApplyCanopyCoefficient(I,WindX,WindY)
  2990: |       I             CALL getBlendFactor(I, bf)
  2991: |                     WSX2(I) = bf*RampMete2*airwaterdensityrat*WDragCo*WindX*WindMag
  2992: |              &               +(1.0d0-bf)*WSX2(I)
  2993: |                     WSY2(I) = bf*RampMete2*airwaterdensityrat*WDragCo*WindY*WindMag
  2994: |              &               +(1.0d0-bf)*WSY2(I)
  2995: |                     vortexPRDIFF = RampMete2*(vortexPRN2(I)-PRBCKGRND_MH2O)
  2996: |                     vortexPRN2(I) = PRBCKGRND_MH2O + vortexPRDIFF
  2997: |                     ! blend vortex into background
  2998: |                     PR2(I) = bf*vortexPRN2(I)+(1.0d0-bf)*PR2(I)
  2999: |                     WVNXOUT(I)=bf*RampMete2*WindX+(1.0d0-bf)*WVNXOUT(I)
  3000: |                     WVNYOUT(I)=bf*RampMete2*WindY+(1.0d0-bf)*WVNYOUT(I)
  3001: +------            ENDDO
  3002:                 ENDIF
