  9060:                 SUBROUTINE NWS14NC_READ_F22(NWS)
  9061:           C----------------------------------------------------------------------
  9062:           C     CPB 10/2023: This subroutine reads the fort.22 file for NWS14 to
  9063:           C     get netcdf variable names as well as starting indices for reading
  9064:           C     in the met data. If we are using grib2 it just returns
  9065:           C----------------------------------------------------------------------
  9066:                 USE SIZES, ONLY : MYPROC
  9067:                 USE GLOBAL, ONLY : NCICE
  9068:                 implicit none
  9069:                 INTEGER,INTENT(IN) :: NWS
  9070:                 logical :: Fexists
  9071:                 integer :: ierr, PvarInd
  9072:                 ! return if we are using grib2
  9073:                 IF (grb2flag) THEN
  9074:                    RETURN
  9075:                 ENDIF
  9076:                 CALL setMessageSource("NWS14NC_READ_F22")
  9077:                 IF (NWS.EQ.-14) THEN
  9078:                    ! For inset OWI winds with netcdf files something needs to be
  9079:                    ! done but I haven't programmed it yet.
  9080:                    CALL allMessage(ERROR,"NWS = -14 has not yet been set up to "
  9081:                &                   //"use netcdf files. Try again with grib2 "
  9082:                &                   //"background wind files.")
