  5016:                 SUBROUTINE HollandGet(WVNX,WVNY,PRESS,TIMELOC)
  5017:                 USE SIZES, ONLY : MyProc, LOCALDIR
  5018:                 USE MESH, ONLY : X, Y, SLAM, SFEA, NP, ICS
  5019:                 USE ADC_CONSTANTS, ONLY : RHOWAT0, G, mb2pa, omega
  5020:                 IMPLICIT NONE
  5021:                 REAL(8), intent(in) :: TIMELOC
