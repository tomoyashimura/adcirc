  2895:                    WTRATIO=(TimeLoc-WTIME1)/WTIMINC
  2896: +------>           DO I=1,NP
  2897: |                     WINDX = WVNX1(I) + WTRATIO*(WVNX2(I)-WVNX1(I))
  2898: |                     WINDY = WVNY1(I) + WTRATIO*(WVNY2(I)-WVNY1(I))
  2899: |                     WINDMAG = SQRT(WINDX*WINDX+WINDY*WINDY)
  2900: |       I             WDragCo = WindDrag(WindMag, I)
