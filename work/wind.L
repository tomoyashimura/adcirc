  2755:           C
  2756:           
  2757:           C     Wind velocity (10 m) and atmospheric pressure are read in from a
  2758:           C     sequence of National Weather Service (NWS) Aviation (AVN) model
  2759:           C     output files. Each AVN file is assumed to contain data on a
  2760:           C     Gaussian longitude, latitude grid at a single time. Consecutive
  2761:           C     files in the sequence are separated by N hours in time. Garratt's
  2762:           C     formula is used to compute wind stress from the wind velocity.
  2763:                 IF(NWS.EQ.10) THEN
  2764:                    WTIME1 = TimeLoc
  2765:                    WTIME2 = WTIME1 + WTIMINC
  2766:                    !
  2767:                    ! jgf51.52.21: Fixed NWS10 and cleaned up interface.
  2768:                    call nws10init()
  2769:                    ! read from fort.200 and spatially interpolate onto adcirc mesh
  2770:                    IF (NCICE.eq.10) THEN
  2771:                       ! read from fort.200 and spatially interpolate onto adcirc mesh
  2772:                       call nws10get(wvnx1,wvny1,prn1,cice1)
  2773:                       ! read from first file after fort.200 and spatially interpolate onto adcirc mesh
  2774:                       call nws10get(wvnx2,wvny2,prn2,cice2)
  2775:                    else
  2776:                       ! read from fort.200 and spatially interpolate onto adcirc mesh
  2777:                       call nws10get(wvnx1,wvny1,prn1)
  2778:                       ! read from first file after fort.200 and spatially interpolate onto adcirc mesh
  2779:                       call nws10get(wvnx2,wvny2,prn2)
  2780:                    endif
  2781:                    !
  2782:                    WTRATIO=(TimeLoc-WTIME1)/WTIMINC
  2783: +------>           DO I=1,NP
  2784: |                     WINDX = WVNX1(I) + WTRATIO*(WVNX2(I)-WVNX1(I))
  2785: |                     WINDY = WVNY1(I) + WTRATIO*(WVNY2(I)-WVNY1(I))
  2786: |                     WINDMAG = SQRT(WINDX*WINDX+WINDY*WINDY)
  2787: |       I             WDragCo = WindDrag(WindMag, I)
  2788: |         C     jgf46.00 Add directional wind reduction.
  2789: |                     IF (LoadDirEffRLen) THEN
  2790: |       I                CALL ApplyDirectionalWindReduction(I, WDragCo,
  2791: |              &              WindMag, DP(I), ETA2(I), WindX, WindY)
  2792: |                        WindMag = SQRT(WindX*WindX+WindY*WindY)
  2793: |       I                WDragCo = WindDrag(WindMag, I)
  2794: |                     ENDIF
  2795: |                     IF (LoadCanopyCoef)
  2796: |       I      &         CALL ApplyCanopyCoefficient(I,WindX,WindY)
  2797: |         C    TCM V49.64.01 ADDED ICE EFFECTS ON WIND DRAG COEFF
  2798: |                     IF (NCICE.eq.10) then
  2799: |                        Cicenow = 100d0*( CICE1(I) +
  2800: |              &                           WTRatio*( CICE2(I)-CICE1(I) ) )
  2801: |                        WDragCo = WindIceDrag(WDragCo,Cicenow)
  2802: |                     ELSEIF (NCICE.NE.0) THEN
  2803: |                        WDragCo = WindIceDrag(WDragCo,ciceout(i))
  2804: |                     ENDIF
  2805: |                     WSX2(I) = RampMete2*airwaterdensityrat*WDRAGCO*WINDX*WINDMAG
  2806: |                     WSY2(I) = RampMete2*airwaterdensityrat*WDRAGCO*WINDY*WINDMAG
  2807: |                     PRDIFF = RampMete2*((PRN1(I)+WTRatio*(PRN2(I)-PRN1(I)))
  2808: |              &                           -PRBCKGRND_MH2O)
  2809: |                     PR2(I) = PRBCKGRND_MH2O + PRDIFF
  2810: +------            END DO
  2811:                 ENDIF
  2812:           
  2813:           C     Wind velocity (10 m) and atmospheric pressure are read in from a
  2814:           C     sequence of stripped down National Weather Service (NWS) ETA 29km
  2815:           C     model output files. Each ETA file is assumed to contain data on an
  2816:           C     E grid for a single day (8 data sets, one every 3 hours, beginning
  2817:           C     @ 03:00 and continuing through 24:00 of the given day). The wind
  2818:           C     data is converted to an east-west, north-south coordinate system
  2819:           C     inside ADCIRC. Garratt's formula is used to compute wind stress
  2820:           C     from the wind velocity.
  2821:                 IF(NWS.EQ.11) THEN
  2822:                    WTIME1=TimeLoc
  2823:                    WTIME2=WTIME1+WTIMINC
  2824:                    NWSEGWI=0
  2825:                    IDSETFLG=0
  2826:                    call allMessage(INFO,
  2827:                &      'The e29 met grid interpolating factors are being computed.')
  2828:                    CALL NWS11GET()        !JUST COMPUTE INTERPOLATING FACTORS
  2829:                    call allMessage(INFO,
  2830:                &      'Finished computing e29 interpolating factors.')
  2831:                    NWSEGWI=0
  2832:                    IDSETFLG=8
  2833:                    CALL NWS11GET()        !NOW COMPUTE HOTSTART WIND FILED
  2834:                    NWSEGWI=1
  2835:                    IDSETFLG=1
  2836: V======>           wvnx1 = wvnx2
  2837: V======>           wvny1 = wvny2
  2838:                    CALL NWS11GET()        !NOW COMPUTE NEXT WIND FIELD
  2839:                    WTRATIO=(TimeLoc-WTIME1)/WTIMINC
  2840: +------>           DO I=1,NP
  2841: |                     WINDX = WVNX1(I) + WTRATIO*(WVNX2(I)-WVNX1(I))
  2842: |                     WINDY = WVNY1(I) + WTRATIO*(WVNY2(I)-WVNY1(I))
  2843: |                     WINDMAG = SQRT(WINDX*WINDX+WINDY*WINDY)
  2844: |       I             WDragCo = WindDrag(WindMag, I)
  2845: |         C     jgf46.00 Add directional wind reduction.
  2846: |                     IF (LoadDirEffRLen) THEN
  2847: |       I                CALL ApplyDirectionalWindReduction(I, WDragCo,
  2848: |              &              WindMag, DP(I), ETA2(I), WindX, WindY)
  2849: |                        WindMag = SQRT(WindX*WindX+WindY*WindY)
  2850: |       I                WDragCo = WindDrag(WindMag, I)
  2851: |                     ENDIF
  2852: |                     IF (LoadCanopyCoef)
  2853: |       I      &         CALL ApplyCanopyCoefficient(I,WindX,WindY)
  2854: |         C    TCM V49.64.01 ADDED ICE EFFECTS ON WIND DRAG COEFF
  2855: |                     IF(NCICE.NE.0) THEN
  2856: |                        WDragCo = WindIceDrag(WDragCo,ciceout(i))
  2857: |                     ENDIF
  2858: |                     WSX2(I) = RampMete2*airwaterdensityrat*WDRAGCO*WINDX*WINDMAG
  2859: |                     WSY2(I) = RampMete2*airwaterdensityrat*WDRAGCO*WINDY*WINDMAG
  2860: |         C  tcm v49.16 20100617
  2861: |         !            PR2(I)=RampMete2*(PRN1(I)+WTRATIO*(PRN2(I)-PRN1(I)))
  2862: |                     PRDIFF = RampMete2*((PRN1(I)+WTRatio*(PRN2(I)-PRN1(I)))
  2863: |              &                           -PRBCKGRND_MH2O)
  2864: |                     PR2(I) = PRBCKGRND_MH2O + PRDIFF
  2865: +------            END DO
  2866:                 ENDIF
  2867:           C
  2868:           C.....sb46.28sb01 NWS=12,-12 were added to deal with raw OWI files.  09/xx/2006
  2869:                 ! jgf: Combined NWS=12 and NWS=-12 and added abs(NWS)=29 and abs(NWS)=30
