   707:                          Drag(3) = rawGarrattWindDrag
   708:                          IF(Drag(3).GT.0.0018D0)THEN
   709:                             IF(WindSpeed.LE.25.0D0)THEN
   710:                                Drag(3) = 0.0018D0
