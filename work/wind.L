  9093:                 read(22,*) Tvar    ! Time variable name
  9094:                 read(22,*) Tformat ! Format of time datestr
  9095:                 read(22,*) Londim  ! Lon dimension name
  9096:                 read(22,*) Lonvar  ! Lon var name
  9097:                 read(22,*) Latdim  ! Lat dimension name
  9098:                 read(22,*) Latvar  ! Lat var name
  9099:                 read(22,*) Pvar    ! Pressure var name
  9100:                 read(22,*) Uvar    ! U10 var name
  9101:                 read(22,*) Vvar    ! V10 Var name
