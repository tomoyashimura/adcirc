   740:                 implicit none
   741:                 REAL(8) :: PercentIce
   742:                 REAL(8) :: pic, WindDrag, IceDrag, Cform
   743:                 REAL(8) :: Cskin = 1.5d-3, Cform_max = 3.67d-3, beta = 0.6d0
   744:           
   745:           #ifndef ES_TUNE
   746:                 SELECT CASE(TRIM(DragLawString))
   747:           C
   748:                 CASE("RaysIce")
   749:           C........If there is virtually no ice, then
   750:           C........just use the non-ice drag values
   751:                    if (PercentIce .lt. 1.d0) then
   752:                       WindIceDrag = WindDrag
   753:                    else
   754:                       pic = PercentIce*0.01d0
   755:                       IceDrag = (0.125d0 + 0.5d0*pic*(1.0d0-pic))*0.01d0
   756:                       WindIceDrag = max(IceDrag,WindDrag)
   757:                    endif
   758:           
   759:                 CASE("IceCube")
   760:           C........This formula is a cubic function such that
   761:           C....... When pic = 0 the drag coefficient is equal to
   762:           C....... the minimum value for Garratt (.000075), when pic = 50
   763:           C....... it has a value of 0.0025 and a zero gradient, and
   764:           C....... when pic = 100 it has a value of 0.00125.
   765:           C....... This represents a smoother transition between Garratt
   766:           C....... and Ray's Ice for low ice values and low winds
   767:           
   768:                    IF (PercentIce.lt.0.d0) then
   769:                       WindIceDrag = WindDrag
   770:                    ELSE
   771:                       pic = PercentIce*0.01d0
   772:                       IceDrag = (0.075d0 + 0.75d0*pic - 0.9d0*pic*pic
   773:                &              + 0.2d0*pic*pic*pic)*0.01d0
   774:                       WindIceDrag = max(IceDrag,WindDrag)
   775:                    ENDIF
   776:            
   777:                 CASE("Lupkes","default","Powell")
   778:           C........This formula is a function that explicitly
   779:           C....... combines air-sea drag (Garratt) with sea-ice skin drag and
   780:           C....... sea-ice form drag components with area fraction weights
   781:           C....... see: Lüpkes, et al. (2012), JGR: doi:10.1029/2012JD017630. &
   782:           C....... Joyce et al. (2019), OM: doi:10.1016/j.ocemod.2019.101421
   783:                    IF (PercentIce.lt.0.d0) then
   784:                       WindIceDrag = WindDrag
   785:                    ELSE
   786:                       pic = min(PercentIce*0.01d0,1d0)
   787:                       pic = PercentIce*0.01d0
   788:                       Cform = Cform_max*(1d0-pic)**beta
   789:                       WindIceDrag = WindDrag*(1d0 - pic) + (Cskin + Cform)*pic
   790:                    ENDIF
