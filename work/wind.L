  8856:                 SUBROUTINE NWS14CHECK_FILETYPE()
  8857:           C----------------------------------------------------------------------
  8858:           C     CPB 10/2023: This subroutine simply checks whether we are using
  8859:           C     grib2 or netCDF winds in NWS14 and sets the grb2flag logical
  8860:           C     appropriately. It does this by:
  8861:           C        1. Checking if the pressure grib2 file (fort.221.grb2) exists
  8862:           C        2. If it does not exist or if we are compiled without grib2
  8863:           C           then it checks if the pressure netCDF file (fort.221.nc)
  8864:           C           exists.
  8865:           C        3. If neither exist we abort with an error message.
  8866:           C----------------------------------------------------------------------
  8867:                 implicit none
  8868:                 logical :: Fexists
  8869: +======>        Pfile = 'fort.221.grb2'
  8870:                 INQUIRE(file=Pfile,exist=Fexists)
  8871:           #ifdef GRIB2API
  8872:                 IF (Fexists) THEN
  8873:           
  8874:                    grb2flag = .TRUE.
  8875:                    RETURN
  8876:                 ENDIF
  8877:           #endif
  8878: +======>        Pfile = 'fort.221.nc'
  8879:                 INQUIRE(file=Pfile,exist=Fexists)
  8880:                 IF (Fexists) THEN
  8881:                    grb2flag = .FALSE.
  8882:                    RETURN
  8883:                 ELSE
  8884:                    call allMessage(ERROR,
  8885:                &       'Neither .grb2 nor .nc wind files exist. Or, if .grb2 '//
  8886:                &       'files exist, did you compile with GRIB2 compiler flags?')
  8887:         I          call windTerminate()
  8888:                 ENDIF
  8889:           
  8890:           C----------------------------------------------------------------------
  8891:                 END SUBROUTINE NWS14CHECK_FILETYPE


