  1351: |                     WindMag = SQRT(WindX*WindX+WindY*WindY)
  1352: |       I             WDragCo = WindDrag(WindMag, I)
  1353: |         C     jgf46.00 Add directional wind reduction.
  1354: |                     IF (LoadDirEffRLen) THEN
  1355: |       I                CALL ApplyDirectionalWindReduction(I, WDragCo,
  1356: |              &              WindMag, DP(I), ETA2(I), WindX, WindY)
  1357: |                        WindMag = SQRT(WindX*WindX+WindY*WindY)
  1358: |       I                WDragCo = WindDrag(WindMag, I)
  1359: |                     ENDIF
  1360: |                     IF (LoadCanopyCoef)
  1361: |       I      &         CALL ApplyCanopyCoefficient(I,WindX,WindY)
  1362: |         C    TCM V49.64.01 ADDED ICE EFFECTS ON WIND DRAG COEFF
