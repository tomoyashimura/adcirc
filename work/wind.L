  1142: |                     WSY2(I) = RampMete*airwaterdensityrat*WDragCo*WindY*WindMag
  1143: |         C  tcm v49.16 20100617
  1144: |         !            PR2(I)=RampMete*(PRN1(I)+WTRatio*(PRN2(I)-PRN1(I)))
  1145: |                     PRDIFF = RampMete*((PRN1(I)+WTRatio*(PRN2(I)-PRN1(I)))
  1146: |              &                           -PRBCKGRND_MH2O)
