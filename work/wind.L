  1312: |                     ENDIF
  1313: |                     WSX2(I) = RampMete*airwaterdensityrat*WDragCo*WindX*WindMag
  1314: |                     WSY2(I) = RampMete*airwaterdensityrat*WDragCo*WindY*WindMag
  1315: |                     PRDIFF = RampMete*((PRN1(I)+WTRatio*(PRN2(I)-PRN1(I)))
  1316: |              &                          -PRBCKGRND_MH2O)
  1317: |                     PR2(I) = PRBCKGRND_MH2O + PRDIFF
  1318: |                     WVNXOUT(I)=RampMete*WindX
  1319: |                     WVNYOUT(I)=RampMete*WindY
  1320: +------            END DO
  1321:                 ENDIF
  1322:           C
  1323:           C     Wind velocity (10 m) and atmospheric pressure are read in from a
  1324:           C     sequence of stripped down National Weather Service (NWS) ETA 29km
  1325:           C     model output files. Each ETA file is assumed to contain data on an
  1326:           C     E grid for a single day (8 data sets, one every 3 hours, beginning
  1327:           C     @ 03:00 and continuing through 24:00 of the given day). The wind
  1328:           C     data is converted to an east-west, north-south coordinate system
  1329:           C     inside ADCIRC. Garratt's formula is used to compute wind stress
  1330:           C     from the wind velocity.
  1331:                 IF(NWS.EQ.11) THEN
  1332:                    IF(TimeLoc.GT.WTIME2) THEN
