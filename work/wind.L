  1416:                    IF (NWS.eq.-14) then
  1417:                       IF (TimeLoc.GT.WTIME2_12) THEN
  1418:                          ! Now get OWI file data (will overwrite where data
  1419:                          ! exists)
  1420:                          WTIME1_12 = WTIME2_12
  1421:                          WTIME2_12 = WTIME2_12 + WTIMINC_12
  1422:                          ! Don't do this is we have already for NWS = 14 data
  1423:                          ! on same time snap
  1424:                          IF (.not.CHANGE_14) THEN
  1425: V------>                    DO I = 1,NP
  1426: |                              IF (.not.HasData(I)) cycle
  1427: |                              WVNX1(I) = WVNX2(I)
  1428: |                              WVNY1(I) = WVNY2(I)
