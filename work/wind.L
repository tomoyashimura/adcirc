  5063:                 ! @jasonfleming: If this is a "CALM" period, set winds to zero
  5064:                 ! velocity and pressure equal to the background pressure and return.
  5065:                 if ( cpress.lt.0.d0 ) then
  5066: V------>           press(:) = PRBCKGRND * mb2pa / rhoWat0g ! convert mb to mH2O
  5067: |                  wvnx(:)=0.d0
  5068: V------            wvny(:)=0.d0
  5069:                    EyeLat(1) = EyeLat(2)
  5070:                    EyeLon(1) = EyeLon(2)
  5071:                    EyeLat(2) = EyeLat(3)
  5072:                    EyeLon(2) = EyeLon(3)
  5073:                    EyeLat(3) = lat
  5074:                    EyeLon(3) = lon
  5075:                    FoundEye = .true.
  5076:           #if defined(WIND_TRACE) || defined(ALL_TRACE)
  5077:                    call allMessage(DEBUG,"Return.")
  5078:           #endif
  5079:                    call unsetMessageSource()
  5080:                    return
  5081:                 endif
  5082:           C
  5083:           C     jgf50.32: If we are using sector-based wind drag, record the location
  5084:           C     of the center of the storm.
  5085:                 IF ((lat.ne.EyeLat(3)).or.(lon.ne.EyeLon(3))) THEN
  5086:                    EyeLat(1) = EyeLat(2)
  5087:                    EyeLon(1) = EyeLon(2)
  5088:                    EyeLat(2) = EyeLat(3)
  5089:                    EyeLon(2) = EyeLon(3)
  5090:                    EyeLat(3) = lat
  5091:                    EyeLon(3) = lon
  5092:                    FoundEye = .true.
  5093:                 ENDIF
  5094:           C
  5095:           C     Calculate and limit central pressure deficit; some track files
  5096:           C     (e.g., Charley 2004) may have a central pressure greater than the
  5097:           C     ambient pressure that this subroutine assumes
  5098:           
  5099:           C     jgf51.14: Apply a factor of 100.0 to convert PRBCKGRND from
