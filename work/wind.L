   701:                          ELSEIF(WindSpeed.LE.45.0D0)THEN
   702:                             Drag(2) = 0.0020D0 + (0.0010D0-0.0020D0)/(45.0D0-35.0D0)*(WindSpeed-35.0D0)
   703:                          ELSE
   704:                             Drag(2) = 0.0010D0
   705:                          ENDIF
