  8894:                 SUBROUTINE NWS14SET_FILENAMES()
  8895:           C----------------------------------------------------------------------
  8896:           C     CPB 10/2023: This subroutine sets the met forcing filenames based
  8897:           C     on grb2flag as well as the existence or lack thereof of various
  8898:           C     files. It also opens the netcdf files in read only mode to
  8899:           C     eliminate opening/closing the files repeatedly
  8900:           C----------------------------------------------------------------------
  8901:           #ifdef ADCNETCDF
  8902:                 use netcdf
  8903:                 use netcdf_error, only: check_err
  8904:           #endif
  8905:           #ifdef CMPI
  8906:                 USE MESSENGER, ONLY: MSG_BARRIER
  8907:           #endif
  8908:                 USE SIZES, ONLY : MYPROC
  8909:                 USE GLOBAL, ONLY : NCICE
  8910:                 implicit none
  8911:                 logical :: Fexists
  8912:                 ! grib2
  8913:                 IF (grb2flag) THEN
  8914: +======>           Pfile = 'fort.221.grb2'
  8915: +======>           Pinv  = 'fort.221.inv'
  8916: +======>           Wfile = 'fort.222.grb2'
  8917: +======>           Wfile1 = 'fort.222.grb2'
  8918: +======>           Winv  = 'fort.222.inv'
  8919: +======>           Cfile = 'fort.225.grb2'
  8920: +======>           Cinv  = 'fort.225.inv'
  8921:           
  8922: +======>           Pvar = 'S'  ! searching for PRMSL or MSLET or PRES:SURFACE
  8923:                                ! prev: :PRMSL:mean sea level:'
  8924: +======>           Uvar = ':UGRD:10 m above ground:'
  8925: +======>           Vvar = ':VGRD:10 m above ground:'
  8926: +======>           Cvar = ':ICEC:surface:'
  8927:                    ! Assign dummy values to ncid variables
  8928:                    PfileNCID = -9999
  8929:                    WfileNCID = -9999
  8930:                    Wfile1NCID = -9999
  8931:                    IF (NCICE.EQ.14) THEN
  8932:                       CfileNCID = -9999
  8933:                    ENDIF
  8934:                    RETURN
  8935:                 ELSEIF (.NOT.grb2flag) THEN
  8936: +======>           Pfile = 'fort.221.nc'
  8937: +======>           Wfile = 'fort.222.nc'
  8938: +======>           Wfile1 = 'fort.222.nc'
  8939: +======>           Cfile = 'fort.225.nc'
  8940:                    ! check if we are using two different wind files
  8941:                    INQUIRE(FILE=Wfile,exist=Fexists)
  8942:                    IF (.NOT.Fexists) THEN
  8943:                       ! using 2 wind files
  8944: +======>              Wfile = 'fort.222u.nc'
  8945: +======>              Wfile1 = 'fort.222v.nc'
  8946:                    ENDIF
  8947:                    ! create dummy names for the inventory files
  8948: +======>           Pinv = 'dmy'
  8949: +======>           Winv = 'dmy'
  8950: +======>           Cinv = 'dmy'
  8951:                    ! create dummy names for the grib2 variables
  8952: +======>           Pvar = 'dmy'
  8953: +======>           Uvar = 'dmy'
  8954: +======>           Vvar = 'dmy'
  8955: +======>           Cvar = 'dmy'
  8956:           
  8957:           #ifdef ADCNETCDF ! BEGIN ADCNETCDF
  8958:                    IF ( read_NWS14_NetCdf_using_core_0 ) THEN
  8959:                      IF ( MYPROC .EQ. 0 ) THEN
  8960:                        call Check_err(NF90_OPEN(Pfile,nf90_nowrite,PfileNCID))
  8961:                        call Check_err(NF90_OPEN(Wfile,nf90_nowrite,WfileNCID))
  8962:                        call Check_err(NF90_OPEN(Wfile1,nf90_nowrite,Wfile1NCID))
  8963:                        IF (NCICE.EQ.14) THEN
