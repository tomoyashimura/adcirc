  1175: |                     WindY = WVNY1(I) + WTRatio*(WVNY2(I)-WVNY1(I))
  1176: |                     WindMag = SQRT(WindX*WindX+WindY*WindY)
  1177: |       I             WDragCo = WindDrag(WindMag, I)
  1178: |         C     jgf46.00 Add directional wind reduction.
  1179: |                     IF (LoadDirEffRLen) THEN
  1180: |       I                CALL ApplyDirectionalWindReduction(I, WDragCo,
  1181: |              &              WindMag, DP(I), ETA2(I), WindX, WindY)
