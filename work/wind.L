  1192: |                     WSY2(I) = RampMete*airwaterdensityrat*WDragCo*WindY*WindMag
  1193: |         C  tcm v49.16 20100617
  1194: |         !            PR2(I)=RampMete*(PRN1(I)+WTRatio*(PRN2(I)-PRN1(I)))
  1195: |                     PRDIFF = RampMete*((PRN1(I)+WTRatio*(PRN2(I)-PRN1(I)))
