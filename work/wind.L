  2907: |                     IF (LoadCanopyCoef)
  2908: |       I      &         CALL ApplyCanopyCoefficient(I,WindX,WindY)
  2909: |         C    TCM V49.64.01 ADDED ICE EFFECTS ON WIND DRAG COEFF
  2910: |                     WSX2(I) = RampMete2*airwaterdensityrat*WDRAGCO*WINDX*WINDMAG
  2911: |                     WSY2(I) = RampMete2*airwaterdensityrat*WDRAGCO*WINDY*WINDMAG
  2912: |                     PRDIFF = RampMete2*((PRN1(I)+WTRatio*(PRN2(I)-PRN1(I)))
  2913: |              &                          -PRBCKGRND_MH2O)
  2914: |                     PR2(I) = PRBCKGRND_MH2O + PRDIFF
  2915: |                     WVNXOUT(I)=RampMete2*WINDX
