  5045:           C
  5046:           C
  5047:                 IF (FIRSTCALL) THEN
  5048:                    FIRSTCALL = .False.
  5049:                    ALLOCATE (RAD(NP),DX(NP),DY(NP),XCOOR(NP),YCOOR(NP))
  5050:                    ALLOCATE (V_r(NP),THETA(NP))
  5051:           C
  5052:           C     The subroutine only works for ICS=2 (spherical coordinates)
  5053: V------>           DO I=1,NP
  5054: |                     XCOOR(I)=SLAM(I)*RAD2DEG
  5055: |                     YCOOR(I)=SFEA(I)*RAD2DEG
  5056: V------            END DO
  5057:                 ENDIF
