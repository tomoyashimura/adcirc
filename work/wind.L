  1087: |       I                WDragCo = WindDrag(WindMag, I)
  1088: |                     ENDIF
  1089: |                     IF (LoadCanopyCoef)
  1090: |       I      &         CALL ApplyCanopyCoefficient(I,WindX,WindY)
  1091: |         C    TCM V49.64.01 ADDED ICE EFFECTS ON WIND DRAG COEFF
  1092: |                     IF(NCICE.NE.0) THEN
  1093: |                        WDragCo = WindIceDrag(WDragCo,ciceout(i))
  1094: |                     ENDIF
  1095: |                     WSX2(I) = RampMete*airwaterdensityrat*WDragCo*WindX*WindMag
  1096: |                     WSY2(I) = RampMete*airwaterdensityrat*WDragCo*WindY*WindMag
  1097: |         C  tcm v49.16 20100617
  1098: |         !            PR2(I)=RampMete*(PRN1(I)+WTRatio*(PRN2(I)-PRN1(I)))
  1099: |                     PRDIFF = RampMete*((PRN1(I)+WTRatio*(PRN2(I)-PRN1(I)))
  1100: |              &                           -PRBCKGRND_MH2O)
  1101: |                     PR2(I) = PRBCKGRND_MH2O + PRDIFF
  1102: |                     WVNXOUT(I)=RampMete*WindX
  1103: |                     WVNYOUT(I)=RampMete*WindY
  1104: +------            END DO
