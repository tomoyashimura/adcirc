  5139:           C     Calculate wind velocity and pressure at each node.
  5140: +------>        DO I=1,NP
  5141: |                  DX(I)=(XCOOR(I)-lon)*DEG2RAD
  5142: |                  DY(I)=(YCOOR(I)-lat)*DEG2RAD
  5143: |                  THETA(I)=ATAN2(DY(I),DX(I))
  5144: |         C     RJW v48.45
  5145: |         C     Compute the distances based on haversine formula for distance along a sphere
  5146: |                  rad(i) = sphericalDistance(DX(I),DY(I),lat, ycoor(i))
  5147: |         C     Compute coriolis
  5148: |                  coriolis = 2.0d0 * omega * sin(YCOOR(I)*DEG2RAD)
  5149: |         C     Compute pressure field
  5150: |         !P.V 11/04/2022 to account for Southern Hemisphere
  5151: |         !         PRESS(I)=(cpress+(centralPressureDeficit)*
  5152: |         !     &        EXP(-(RMW*1000.d0/RAD(I))**B)) / (RHOWAT0*G)
  5153: |                  PRESS(I)=cpress+(centralPressureDeficit)*
  5154: |              &        EXP(-(RMW*1000.d0/RAD(I))**B)
  5155: |         C     Compute velocity field with absolute around
  5156: |         C     CORIOLIS for the Southern Hempisphere
  5157: |                  V_r(I) = sqrt(
  5158: |              &        (RMW*1000.d0/RAD(I))**B *
  5159: |              &        EXP(1.d0-(RMW*1000.d0/RAD(I))**B)*spd**2.d0
  5160: |              &        + (RAD(I)**2.d0)*(CORIOLIS**2.d0)/4.d0
  5161: |              &        )
  5162: |              &        - RAD(I)*ABS(CORIOLIS)/2.d0
  5163: |         C
  5164: |         C     jgf46.31 Determine translation speed that should be added to final
  5165: |         C     storm wind speed. This is tapered to zero as the storm wind tapers
  5166: |         C     to zero toward the eye of the storm and at long distances from the
  5167: |         C     storm.
  5168: |                  TransSpdX = (abs(V_r(I))/spd)*TVX
  5169: |                  TransSpdY = (abs(V_r(I))/spd)*TVY
  5170: |         C     Apply mutliplier for Storm2 in LPFS ensemble.
  5171: |                  V_r(I) = V_r(I) * WindMultiplier
  5172: |         C
  5173: |         C     Find the velocity components.
  5174: |         !P.V 11/04/2022 to account for Southern Hemisphere
  5175: |                 !WVNX(I)=-V_r(I)*SIN(THETA(I))
  5176: |                 !WVNY(I)= V_r(I)*COS(THETA(I))
  5177: |                 ! Find the wind velocity components (caution to SH/NH)
  5178: |                 if(lat.lt.0.d0) then ! SH
  5179: |                  WVNX(I)= V_r(I)*SIN(THETA(I))
  5180: |                  WVNY(I)=-V_r(I)*COS(THETA(I))
  5181: |                 else ! NH
  5182: |                  WVNX(I)=-V_r(I)*SIN(THETA(I))
  5183: |                  WVNY(I)= V_r(I)*COS(THETA(I))
  5184: |                 endif
  5185: |          
  5186: |         C
