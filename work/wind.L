   965:           C------------------------MET FORCING---------------------------------------
   966:           C
   967:           C...  UPDATE THE WIND STRESS AND SURFACE PRESSURE AND READ IN NEW VALUES
   968:           C...  FROM UNIT 22.  APPLY Ramp FUNCTION.
   969:           C
   970:           C  tcm v49.16 20100617 -- Changed pressure ramping so that we apply the ramp
   971:           C     to the difference between the background pressure and the forced pressure,
   972:           C     then add that ramped difference back to the background pressure
   973:           C
   974:           C     No wind, radiation stress or atmospheric pressure forcings are used.
   975:                 IF(NWS.EQ.1) THEN
   976: +------>           DO I=1,NP
   977: |                     READ(22,*) NHG,WSX2(I),WSY2(I),PR2(I) !read in
   978: |                     WSX2(I)=RampMete*WSX2(I) ! apply ramp function
   979: |                     WSY2(I)=RampMete*WSY2(I)
   980: |         C  tcm v49.16 20100617
   981: |         !            PR2(I)=RampMete*PR2(I)
   982: |                     PRDIFF = RampMete*(PR2(I)-PRBCKGRND_MH2O)
   983: |                     PR2(I) = PRBCKGRND_MH2O + PRDIFF
   984: |                     wvnxout(i)=WSX2(i) ! for met recording station output
   985: |                     wvnyout(i)=WSY2(i)
   986: +------            END DO
   987:                 ENDIF
   988:           
   989:           C     Wind stress and atmospheric pressure are read in at all grid nodes
   990:           C     at a time interval that does not equal the model time
   991:           C     step. Interpolation in time is used to synchronize the wind and
   992:           C     pressure information with the model time step.
   993:                 IF(ABS(NWS).EQ.2) THEN
   994:                    IF(TimeLoc.GT.WTIME2) THEN !determine if met file time incr. is exceeded
   995:                       WTIME1=WTIME2
   996:                       WTIME2=WTIME2+WTIMINC
   997: +------>              DO I=1,NP
   998: |                        WVNX1(I)=WVNX2(I) ! move current data to old
   999: |                        WVNY1(I)=WVNY2(I)
  1000: |                        PRN1(I)=PRN2(I)
  1001: |                        READ(22,*) NHG,WVNX2(I),WVNY2(I),PRN2(I) ! read in
  1002: +------               END DO
  1003:                    ENDIF
  1004:                    WTRatio=(TimeLoc-WTIME1)/WTIMINC ! interpolate
  1005: V------>           DO I=1,NP
  1006: |       F             WindX = WVNX1(I) + WTRatio*(WVNX2(I)-WVNX1(I))
  1007: |       F             WindY = WVNY1(I) + WTRatio*(WVNY2(I)-WVNY1(I))
  1008: |                     WSX2(I) = RampMete*WindX !apply ramp
  1009: |                     WSY2(I) = RampMete*WindY
  1010: |         C  tcm v49.16 20100617
  1011: |         !            PR2(I)=RampMete*(PRN1(I)+WTRatio*(PRN2(I)-PRN1(I)))
  1012: |       F             PRDIFF = RampMete*((PRN1(I)+WTRatio*(PRN2(I)-PRN1(I)))
  1013: |              &                          -PRBCKGRND_MH2O)
  1014: |       F             PR2(I) = PRBCKGRND_MH2O + PRDIFF
  1015: |                     wvnxout(i)=WSX2(i) !for met recording sta. output
  1016: |                     wvnyout(i)=WSY2(i)
  1017: V------            END DO
  1018:                 ENDIF
  1019:           
  1020:           C     Wind velocity in US Navy Fleet Numeric format interpolated in
  1021:           C     space onto the ADCIRC grid and in time to synchronize the wind and
  1022:           C     pressure information with the model time step. Garratt's formula
  1023:           C     is used to compute wind stress from the wind velocity.
  1024:                 IF(NWS.EQ.3) THEN
  1025:                    IF(TimeLoc.GT.WTIME2) THEN
  1026:                       WTIME1=WTIME2
  1027:                       WTIME2=WTIME2+WTIMINC
