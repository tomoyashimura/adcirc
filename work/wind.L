  5210: |         !P.V 11/04/2022
  5211: |                 PRESS(I) = max(0.85d5,min(1.1e5,PRESS(I))) !Typhoon Tip 870 hPa ... 12-oct-1979
  5212: |                 WVNX(I)  = max(-200.d0,min(200.d0,WVNX(I)))
  5213: |                 WVNY(I)  = max(-200.d0,min(200.d0,WVNY(I)))
  5214: |                 !-------------------------------------------
