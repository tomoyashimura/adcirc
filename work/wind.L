  1036: |                     WindX = WVNX1(I) + WTRatio*(WVNX2(I)-WVNX1(I))
  1037: |                     WindY = WVNY1(I) + WTRatio*(WVNY2(I)-WVNY1(I))
  1038: |                     WindMag = SQRT(WindX*WindX+WindY*WindY)
  1039: |       I             WDragCo = WindDrag(WindMag, I)
  1040: |         C     jgf46.00 Add directional wind reduction.
  1041: |                     IF (LoadDirEffRLen) THEN
  1042: |       I                CALL ApplyDirectionalWindReduction(I, WDragCo,
  1043: |              &              WindMag, DP(I), ETA2(I), WindX, WindY)
  1044: |                        WindMag = SQRT(WindX*WindX+WindY*WindY)
  1045: |       I                WDragCo = WindDrag(WindMag, I)
  1046: |                     ENDIF
  1047: |                     IF (LoadCanopyCoef)
  1048: |       I      &         CALL ApplyCanopyCoefficient(I,WindX,WindY)
  1049: |         C    TCM V49.64.01 ADDED ICE EFFECTS ON WIND DRAG COEFF
  1050: |                     IF(NCICE.NE.0) THEN
  1051: |                        WDragCo = WindIceDrag(WDragCo,ciceout(i))
  1052: |                     ENDIF
  1053: |                     WSX2(I) = RampMete*airwaterdensityrat*WDragCo*WindX*WindMag
  1054: |                     WSY2(I) = RampMete*airwaterdensityrat*WDragCo*WindY*WindMag
  1055: |                     WVNXOUT(I)=RampMete*WindX
  1056: |                     WVNYOUT(I)=RampMete*WindY
  1057: +------            END DO
