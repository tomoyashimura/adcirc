  1366: |                     WSX2(I) = RampMete*airwaterdensityrat*WDragCo*WindX*WindMag
  1367: |                     WSY2(I) = RampMete*airwaterdensityrat*WDragCo*WindY*WindMag
  1368: |         C  tcm v49.16 20100617
  1369: |                     PRDIFF = RampMete*((PRN1(I)+WTRatio*(PRN2(I)-PRN1(I)))
  1370: |              &                          -PRBCKGRND_MH2O)
  1371: |                     PR2(I) = PRBCKGRND_MH2O + PRDIFF
  1372: |                     WVNXOUT(I)=RampMete*WindX
  1373: |                     WVNYOUT(I)=RampMete*WindY
