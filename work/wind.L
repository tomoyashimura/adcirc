  1445: |                     WINDX = WVNX1(I) + WTRATIO*(WVNX2(I)-WVNX1(I))
  1446: |                     WINDY = WVNY1(I) + WTRATIO*(WVNY2(I)-WVNY1(I))
  1447: |                     WINDMAG = SQRT(WINDX*WINDX+WINDY*WINDY)
  1448: |                     !Casey 110518: Enable Mark Powell's sector-based wind drag.
  1449: |       I             WDragCo = WindDrag(WindMag, I)
  1450: |                     IF (LoadDirEffRLen) THEN
  1451: |       I               CALL ApplyDirectionalWindReduction(I, WDragCo,
  1452: |              &             WindMag, DP(I), ETA2(I), WindX, WindY)
  1453: |                       WindMag = SQRT(WindX*WindX+WindY*WindY)
  1454: |                       !Casey 110518: Enable Mark Powell's sector-based wind drag.
  1455: |       I               WDragCo = WindDrag(WindMag,I)
  1456: |                     ENDIF
  1457: |                     IF (LoadCanopyCoef) then
  1458: |       I                CALL ApplyCanopyCoefficient(I,WindX,WindY)
  1459: |                     ENDIF
  1460: |         C    TCM V49.64.01 ADDED ICE EFFECTS ON WIND DRAG COEFF
  1461: |                     IF (NCICE.eq.14) then
  1462: |                        Cicenow = 100d0*(CICE1(I) +
  1463: |              &                          CTRATIO*(CICE2(I)-CICE1(I)))
  1464: |                        WDragCo = WindIceDrag(WDragCo,Cicenow)
  1465: |                        ciceout(i) = Cicenow ! GML added 20210727
  1466: |                     elseif (NCICE.ne.0.and.NCICE.ne.13) THEN
  1467: |                        WDragCo = WindIceDrag(WDragCo,ciceout(i))
  1468: |                     endif
  1469: |                     ! WJP: added varying sea surface density
  1470: |                     if (abs(IDEN).ge.5) then
  1471: |                        if (SigTS(I) < -1d2) then
  1472: |                           airwaterdensityrat = rhoAir/RhoWat0
  1473: |                        else
  1474: |                           airwaterdensityrat = rhoAir/(SigTS(I) + RhoWat0)
  1475: |                        endif
  1476: |                     endif
  1477: |                     WSX2(I) = RampMete*airwaterdensityrat*WDRAGCO*WINDX*WINDMAG
  1478: |                     WSY2(I) = RampMete*airwaterdensityrat*WDRAGCO*WINDY*WINDMAG
  1479: |                     PRDIFF  = RampMete*((PRN1(I)+WTRatio*(PRN2(I)-PRN1(I)))
  1480: |              &                          -PRBCKGRND_MH2O)
  1481: |         #ifdef NOIVB
  1482: |                     PR2(I)  = PRBCKGRND_MH2O
  1483: |         #else
  1484: |                     PR2(I)  = PRBCKGRND_MH2O + PRDIFF
  1485: |         #endif
  1486: |                     WVNXOUT(I) = RampMete*WINDX
  1487: |                     WVNYOUT(I) = RampMete*WINDY
  1488: |         
  1489: +------             END DO
